---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/navbar'
import Footer from '../components/footer'
import { getNavLinks } from '../lib/sanity'

const base   = import.meta.env.BASE_URL.replace(/\/$/, '')
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'
const navLinks = await getNavLinks()
---

<Layout title="Mi cuenta — Retro Reeves">
<style>
  body { background: #f5f4ef; }
  .acc-hero { background: #0d0d0d; padding: 5rem 0 2.5rem; }
  .acc-hero__title { font-family: 'Noto Sans', sans-serif; font-weight: 800; font-size: clamp(1.8rem,4vw,2.6rem); letter-spacing: -0.04em; color: #fff; margin: 0 0 0.3rem; }
  .acc-hero__sub   { font-family: 'PT Mono', monospace; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.35); margin: 0; }
  .acc-main  { padding: 2.5rem 0 5rem; }
  .acc-grid  { display: grid; grid-template-columns: 240px 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 700px) { .acc-grid { grid-template-columns: 1fr; } }

  /* sidebar tabs */
  .acc-tabs  { background: #fff; display: flex; flex-direction: column; }
  .acc-tab   { padding: 0.85rem 1.1rem; font-family: 'PT Mono', monospace; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0,0,0,0.45); cursor: pointer; border-left: 2px solid transparent; transition: all 0.18s; background: none; border-top: none; border-right: none; border-bottom: 1px solid rgba(0,0,0,0.06); text-align: left; }
  .acc-tab:hover  { color: #0d0d0d; }
  .acc-tab.active { color: #0d0d0d; font-weight: 700; border-left-color: #0d0d0d; background: #f5f4ef; }
  .acc-tab.danger { color: #c8382a; }
  .acc-tab.danger:hover { background: #fee2e2; }

  /* panels */
  .acc-panel { display: none; }
  .acc-panel.active { display: block; }
  .acc-card  { background: #fff; padding: 1.75rem; margin-bottom: 1rem; }
  .acc-section-title { font-family: 'Noto Sans', sans-serif; font-weight: 800; font-size: 1rem; letter-spacing: -0.02em; margin: 0 0 1.25rem; }
  .acc-label { display: block; font-family: 'PT Mono', monospace; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.38); margin-bottom: 0.3rem; }
  .acc-input { width: 100%; border: 1px solid rgba(0,0,0,0.13); padding: 0.65rem 0.85rem; font-family: 'Noto Sans', sans-serif; font-size: 0.95rem; color: #0d0d0d; background: #fff; outline: none; box-sizing: border-box; border-radius: 0; transition: border-color 0.2s; }
  .acc-input:focus { border-color: #0d0d0d; }
  .acc-input:disabled { background: #f5f4ef; color: rgba(0,0,0,0.4); }
  .acc-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 500px) { .acc-row { grid-template-columns: 1fr; } }
  .acc-btn   { background: #0d0d0d; color: #fff; border: none; padding: 0.8rem 1.5rem; font-family: 'PT Mono', monospace; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; cursor: pointer; border-radius: 0; transition: opacity 0.18s; }
  .acc-btn:hover { opacity: 0.82; }
  .acc-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .acc-btn--outline { background: #fff; color: #0d0d0d; border: 1px solid rgba(0,0,0,0.15); }
  .acc-btn--outline:hover { border-color: #0d0d0d; }
  .acc-btn--danger { background: #c8382a; }
  .acc-ok  { font-family: 'PT Mono', monospace; font-size: 0.72rem; color: #166534; display: none; padding: 0.5rem 0.75rem; background: #dcfce7; margin-top: 0.75rem; }
  .acc-err { font-family: 'PT Mono', monospace; font-size: 0.72rem; color: #c8382a; display: none; padding: 0.5rem 0.75rem; background: #fee2e2; margin-top: 0.75rem; }

  /* address cards */
  .addr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem; margin-bottom: 1rem; }
  .addr-card { border: 1px solid rgba(0,0,0,0.1); padding: 1rem; position: relative; background: #fff; }
  .addr-card.default { border-color: #0d0d0d; }
  .addr-badge { font-family: 'PT Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; background: #0d0d0d; color: #fff; padding: 0.15rem 0.5rem; display: inline-block; margin-bottom: 0.5rem; }
  .addr-name  { font-family: 'Noto Sans', sans-serif; font-weight: 700; font-size: 0.9rem; margin: 0 0 0.2rem; }
  .addr-text  { font-family: 'Noto Sans', sans-serif; font-size: 0.85rem; color: rgba(0,0,0,0.55); margin: 0; line-height: 1.4; }
  .addr-actions { display: flex; gap: 0.4rem; margin-top: 0.75rem; }
  .addr-act-btn { font-family: 'PT Mono', monospace; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.6rem; border: 1px solid rgba(0,0,0,0.15); background: none; cursor: pointer; transition: all 0.15s; color: rgba(0,0,0,0.5); }
  .addr-act-btn:hover { border-color: #0d0d0d; color: #0d0d0d; }
  .addr-act-btn.del:hover { border-color: #c8382a; color: #c8382a; }
  .addr-form { border: 1px solid rgba(0,0,0,0.1); padding: 1.25rem; background: #f5f4ef; display: none; }
  .addr-form.open { display: block; }
  .addr-form-title { font-family: 'PT Mono', monospace; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; margin: 0 0 1rem; }

  /* orders list */
  .order-row { border: 1px solid rgba(0,0,0,0.08); padding: 1rem; background: #fff; margin-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .order-num { font-family: 'PT Mono', monospace; font-size: 0.8rem; font-weight: 700; color: #0d0d0d; }
  .order-date { font-family: 'PT Mono', monospace; font-size: 0.68rem; color: rgba(0,0,0,0.35); letter-spacing: 0.06em; }
  .order-total { font-family: 'PT Mono', monospace; font-size: 0.85rem; font-weight: 700; }
  .order-status { font-family: 'PT Mono', monospace; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; padding: 0.2rem 0.6rem; }
  .s-pending   { background: #fef9c3; color: #854d0e; }
  .s-confirmed { background: #dbeafe; color: #1d4ed8; }
  .s-preparing { background: #ede9fe; color: #6d28d9; }
  .s-shipped   { background: #dbeafe; color: #1e40af; }
  .s-delivered { background: #dcfce7; color: #166534; }
  .s-cancelled { background: #fee2e2; color: #991b1b; }
  .no-content  { font-family: 'PT Mono', monospace; font-size: 0.72rem; color: rgba(0,0,0,0.3); letter-spacing: 0.08em; text-align: center; padding: 2rem; }
</style>

<div>
  <Navbar client:load solid={true} navLinks={navLinks.length ? navLinks : undefined} />

  <div class="acc-hero">
    <div class="container">
      <h1 class="acc-hero__title">Mi cuenta</h1>
      <p class="acc-hero__sub" id="hero-sub">Cargando...</p>
    </div>
  </div>

  <div class="acc-main">
    <div class="container">
      <div class="acc-grid">

        <!-- TABS -->
        <div class="acc-tabs">
          <button class="acc-tab active" data-panel="perfil">Perfil</button>
          <button class="acc-tab" data-panel="direcciones">Mis direcciones</button>
          <button class="acc-tab" data-panel="pedidos">Mis pedidos</button>
          <button class="acc-tab danger" id="btn-logout">Cerrar sesión</button>
        </div>

        <!-- PANELS -->
        <div>

          <!-- PERFIL -->
          <div class="acc-panel active" id="panel-perfil">
            <div class="acc-card">
              <p class="acc-section-title">Datos personales</p>
              <div style="display:flex;flex-direction:column;gap:0.85rem;">
                <div>
                  <label class="acc-label" for="p-name">Nombre completo</label>
                  <input class="acc-input" id="p-name" type="text" />
                </div>
                <div>
                  <label class="acc-label" for="p-email">Correo electrónico</label>
                  <input class="acc-input" id="p-email" type="email" disabled />
                </div>
                <div>
                  <label class="acc-label" for="p-phone">Teléfono (10 dígitos)</label>
                  <input class="acc-input" id="p-phone" type="tel" placeholder="55 1234 5678" />
                </div>
              </div>
              <div style="margin-top:1.25rem;display:flex;gap:0.75rem;align-items:center;">
                <button class="acc-btn" id="btn-save-profile">Guardar cambios</button>
              </div>
              <p class="acc-ok" id="profile-ok">✓ Guardado correctamente</p>
              <p class="acc-err" id="profile-err"></p>
            </div>
          </div>

          <!-- DIRECCIONES -->
          <div class="acc-panel" id="panel-direcciones">
            <div class="acc-card">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
                <p class="acc-section-title" style="margin:0;">Mis direcciones</p>
                <button class="acc-btn acc-btn--outline" id="btn-new-addr">+ Nueva dirección</button>
              </div>

              <div class="addr-grid" id="addr-list">
                <p class="no-content" id="addr-empty" style="grid-column:1/-1">Sin direcciones guardadas</p>
              </div>

              <!-- Form nueva/editar dirección -->
              <div class="addr-form" id="addr-form">
                <p class="addr-form-title" id="addr-form-title">Nueva dirección</p>
                <input type="hidden" id="af-id" />
                <div style="display:flex;flex-direction:column;gap:0.75rem;">
                  <div>
                    <label class="acc-label" for="af-name">Nombre / alias (ej: Casa, Trabajo)</label>
                    <input class="acc-input" id="af-name" type="text" placeholder="Casa" />
                  </div>
                  <div>
                    <label class="acc-label" for="af-street">Calle y número</label>
                    <input class="acc-input" id="af-street" type="text" placeholder="Av. Reforma 123, Col. Centro" />
                  </div>
                  <div class="acc-row">
                    <div>
                      <label class="acc-label" for="af-city">Ciudad / Municipio</label>
                      <input class="acc-input" id="af-city" type="text" placeholder="Cuernavaca" />
                    </div>
                    <div>
                      <label class="acc-label" for="af-state">Estado</label>
                      <input class="acc-input" id="af-state" type="text" placeholder="Morelos" />
                    </div>
                  </div>
                  <div class="acc-row">
                    <div>
                      <label class="acc-label" for="af-zip">Código postal</label>
                      <input class="acc-input" id="af-zip" type="text" placeholder="62000" maxlength="5" />
                    </div>
                    <div>
                      <label class="acc-label" for="af-country">País</label>
                      <input class="acc-input" id="af-country" type="text" value="México" />
                    </div>
                  </div>
                  <div>
                    <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
                      <input type="checkbox" id="af-default" />
                      <span style="font-family:'PT Mono',monospace;font-size:0.52rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(0,0,0,0.5);">Establecer como dirección predeterminada</span>
                    </label>
                  </div>
                </div>
                <div style="display:flex;gap:0.6rem;margin-top:1rem;">
                  <button class="acc-btn" id="btn-save-addr">Guardar dirección</button>
                  <button class="acc-btn acc-btn--outline" id="btn-cancel-addr">Cancelar</button>
                </div>
                <p class="acc-err" id="addr-err"></p>
              </div>
            </div>
          </div>

          <!-- PEDIDOS -->
          <div class="acc-panel" id="panel-pedidos">
            <div class="acc-card">
              <p class="acc-section-title">Mis pedidos</p>
              <div id="orders-list">
                <p class="no-content">Cargando pedidos...</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <Footer />
</div>

<script define:vars={{ apiUrl, base }} is:inline>
  const API = apiUrl || 'http://localhost:3000'
  const STATUS_LABELS = { pending:'Pendiente', confirmed:'Confirmado', preparing:'Preparando', shipped:'Enviado', delivered:'Entregado', cancelled:'Cancelado' }

  let profile = null
  let addresses = []

  // ── CHECK SESSION ──────────────────────────────────────────
  async function init() {
    try {
      const res  = await fetch(`${API}/api/v1/profile`, { credentials: 'include' })
      if (!res.ok) { window.location.href = `${base}/login?return=/mi-cuenta`; return }
      const data = await res.json()
      profile   = data.user
      addresses = data.addresses ?? []
      renderProfile()
      renderAddresses()
      loadOrders()
    } catch {
      window.location.href = `${base}/login?return=/mi-cuenta`
    }
  }

  function renderProfile() {
    document.getElementById('hero-sub').textContent = profile.email
    document.getElementById('p-name').value  = profile.name  ?? ''
    document.getElementById('p-email').value = profile.email ?? ''
    document.getElementById('p-phone').value = profile.phone ?? ''
  }

  // ── TABS ──────────────────────────────────────────────────
  document.querySelectorAll('.acc-tab[data-panel]').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.acc-tab').forEach(t => t.classList.remove('active'))
      document.querySelectorAll('.acc-panel').forEach(p => p.classList.remove('active'))
      tab.classList.add('active')
      document.getElementById('panel-' + tab.dataset.panel)?.classList.add('active')
    })
  })

  // ── LOGOUT ────────────────────────────────────────────────
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await fetch(`${API}/api/auth/sign-out`, { method: 'POST', credentials: 'include' })
    window.location.href = base + '/'
  })

  // ── GUARDAR PERFIL ────────────────────────────────────────
  document.getElementById('btn-save-profile')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-save-profile')
    const ok  = document.getElementById('profile-ok')
    const err = document.getElementById('profile-err')
    ok.style.display = 'none'; err.style.display = 'none'
    btn.disabled = true
    try {
      const res = await fetch(`${API}/api/v1/profile`, {
        method: 'PATCH', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name:  document.getElementById('p-name').value.trim(),
          phone: document.getElementById('p-phone').value.trim(),
        }),
      })
      if (res.ok) { ok.style.display = 'block'; setTimeout(() => ok.style.display = 'none', 3000) }
      else { const d = await res.json(); err.textContent = d.error ?? 'Error al guardar'; err.style.display = 'block' }
    } catch { err.textContent = 'Error de conexión'; err.style.display = 'block' }
    finally   { btn.disabled = false }
  })

  // ── DIRECCIONES ──────────────────────────────────────────
  function renderAddresses() {
    const list  = document.getElementById('addr-list')
    const empty = document.getElementById('addr-empty')
    if (!addresses.length) { empty.style.display = 'block'; list.innerHTML = ''; list.appendChild(empty); return }
    empty.style.display = 'none'
    list.innerHTML = addresses.map(a => `
      <div class="addr-card${a.isDefault ? ' default' : ''}" data-id="${a.id}">
        ${a.isDefault ? '<span class="addr-badge">Predeterminada</span>' : ''}
        <p class="addr-name">${a.name}</p>
        <p class="addr-text">${a.street}<br>${a.city}, ${a.state} ${a.zip}<br>${a.country}</p>
        <div class="addr-actions">
          <button class="addr-act-btn" onclick="editAddr('${a.id}')">Editar</button>
          ${!a.isDefault ? `<button class="addr-act-btn" onclick="setDefault('${a.id}')">Predeterminar</button>` : ''}
          <button class="addr-act-btn del" onclick="deleteAddr('${a.id}')">Eliminar</button>
        </div>
      </div>`).join('')
  }

  document.getElementById('btn-new-addr')?.addEventListener('click', () => openAddrForm(null))
  document.getElementById('btn-cancel-addr')?.addEventListener('click', () => closeAddrForm())

  function openAddrForm(addr) {
    const form = document.getElementById('addr-form')
    document.getElementById('addr-form-title').textContent = addr ? 'Editar dirección' : 'Nueva dirección'
    document.getElementById('af-id').value      = addr?.id      ?? ''
    document.getElementById('af-name').value    = addr?.name    ?? ''
    document.getElementById('af-street').value  = addr?.street  ?? ''
    document.getElementById('af-city').value    = addr?.city    ?? ''
    document.getElementById('af-state').value   = addr?.state   ?? ''
    document.getElementById('af-zip').value     = addr?.zip     ?? ''
    document.getElementById('af-country').value = addr?.country ?? 'México'
    document.getElementById('af-default').checked = addr?.isDefault ?? false
    form.classList.add('open')
    form.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }
  function closeAddrForm() {
    document.getElementById('addr-form').classList.remove('open')
    document.getElementById('addr-err').style.display = 'none'
  }

  window.editAddr = (id) => {
    const addr = addresses.find(a => a.id === id)
    if (addr) openAddrForm(addr)
  }
  window.setDefault = async (id) => {
    await fetch(`${API}/api/v1/profile/addresses/${id}`, {
      method: 'PATCH', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ isDefault: true }),
    })
    const res = await fetch(`${API}/api/v1/profile`, { credentials: 'include' })
    const d   = await res.json(); addresses = d.addresses ?? []; renderAddresses()
  }
  window.deleteAddr = async (id) => {
    if (!confirm('¿Eliminar esta dirección?')) return
    await fetch(`${API}/api/v1/profile/addresses/${id}`, { method: 'DELETE', credentials: 'include' })
    addresses = addresses.filter(a => a.id !== id); renderAddresses()
  }

  document.getElementById('btn-save-addr')?.addEventListener('click', async () => {
    const id = document.getElementById('af-id').value
    const body = {
      name:      document.getElementById('af-name').value.trim(),
      street:    document.getElementById('af-street').value.trim(),
      city:      document.getElementById('af-city').value.trim(),
      state:     document.getElementById('af-state').value.trim(),
      zip:       document.getElementById('af-zip').value.trim(),
      country:   document.getElementById('af-country').value.trim() || 'MX',
      isDefault: document.getElementById('af-default').checked,
    }
    const errEl = document.getElementById('addr-err')
    if (!body.street || !body.city || !body.state || !body.zip) {
      errEl.textContent = 'Completa calle, ciudad, estado y CP.'; errEl.style.display = 'block'; return
    }
    const url    = id ? `${API}/api/v1/profile/addresses/${id}` : `${API}/api/v1/profile/addresses`
    const method = id ? 'PATCH' : 'POST'
    const res    = await fetch(url, { method, credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    if (!res.ok) { const d = await res.json(); errEl.textContent = d.error ?? 'Error'; errEl.style.display = 'block'; return }
    const fresh = await fetch(`${API}/api/v1/profile`, { credentials: 'include' })
    const d     = await fresh.json(); addresses = d.addresses ?? []; renderAddresses(); closeAddrForm()
  })

  // ── PEDIDOS ────────────────────────────────────────────────
  async function loadOrders() {
    const list = document.getElementById('orders-list')
    try {
      const res  = await fetch(`${API}/api/v1/orders/me`, { credentials: 'include' })
      const data = res.ok ? await res.json() : []
      if (!data.length) { list.innerHTML = '<p class="no-content">Aún no tienes pedidos</p>'; return }
      list.innerHTML = data.map(o => {
        const tracking = o.shipment?.trackingNumber
        const carrier  = o.shipment?.carrier ?? ''
        const trackUrl = tracking
          ? `https://miguiaretro.rastreaguia.com/?guia=${encodeURIComponent(tracking)}`
          : null
        return `
        <div class="order-row" style="flex-direction:column;align-items:flex-start;gap:0.6rem;">
          <div style="display:flex;justify-content:space-between;align-items:center;width:100%;flex-wrap:wrap;gap:0.5rem;">
            <div>
              <p class="order-num">#${o.orderNumber}</p>
              <p class="order-date">${new Date(o.createdAt).toLocaleDateString('es-MX', {day:'2-digit',month:'short',year:'numeric'})}</p>
            </div>
            <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
              <span class="order-status s-${o.status}">${STATUS_LABELS[o.status] ?? o.status}</span>
              <span class="order-total">$${Number(o.total).toLocaleString('es-MX')} MXN</span>
            </div>
          </div>
          ${o.items?.length ? `
          <div style="width:100%;border-top:1px solid rgba(0,0,0,0.06);padding-top:0.5rem;display:flex;flex-direction:column;gap:0.2rem;">
            ${o.items.map(it => `<span style="font-family:'Noto Sans',sans-serif;font-size:0.78rem;color:rgba(0,0,0,0.55);">${it.productName} — T:${it.size}${it.color?' · '+it.color:''} × ${it.qty}</span>`).join('')}
          </div>` : ''}
          ${tracking ? `
          <div style="width:100%;border-top:1px solid rgba(0,0,0,0.06);padding-top:0.5rem;display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
            <span style="font-family:'PT Mono',monospace;font-size:0.5rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(0,0,0,0.35);">Guía ${carrier}</span>
            <span style="font-family:'PT Mono',monospace;font-size:0.62rem;font-weight:700;">${tracking}</span>
            <a href="${trackUrl}" target="_blank" rel="noopener noreferrer"
              style="font-family:'PT Mono',monospace;font-size:0.52rem;letter-spacing:0.08em;text-transform:uppercase;background:#0d0d0d;color:#fff;padding:0.3rem 0.7rem;text-decoration:none;white-space:nowrap;">
              Rastrear paquete →
            </a>
          </div>` : o.status === 'shipped' || o.status === 'delivered' ? `
          <p style="font-family:'PT Mono',monospace;font-size:0.5rem;color:rgba(0,0,0,0.3);margin:0;">Guía en proceso de registro</p>` : ''}
        </div>`
      }).join('')
    } catch { list.innerHTML = '<p class="no-content">Error al cargar pedidos</p>' }
  }

  // Abrir tab por hash en URL (#pedidos, #direcciones)
  const hash = window.location.hash.replace('#', '')
  if (hash) {
    const tab = document.querySelector(`.acc-tab[data-panel="${hash}"]`)
    if (tab) tab.click()
  }

  init()
</script>
</Layout>
